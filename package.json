{
  "name": "rebeccawrites",
  "version": "1.2.0",
  "description": "Transcripción local de audio y video",
  "main": "./out/main/index.js",
  "author": "Michael Canales Palomino",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "fetch:bin": "node scripts/fetch-binaries.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "check:bin": "node scripts/check-binaries.mjs",
    "clean:dist": "node scripts/clean-dist.mjs",
    "prebuild:unpack": "npm run build:native && npm run check:bin",
    "prebuild:win": "npm run build:native && npm run check:bin",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run clean:dist && npm run build && electron-builder --win",
    "release": "npm run clean:dist && npm run build:native && npm run check:bin && npm run build && electron-builder --win --publish always",
    "build:native": "cd native && cargo build --release && node ../scripts/copy-native.mjs",
    "icons": "electron scripts/build-icons.mjs",
    "licenses": "node scripts/gen-licenses.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/ffprobe-static": "^2.0.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "i18next": "^26.4.2",
    "lucide-react": "^1.48.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.15",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "productName": "RebeccaWrites"
}
